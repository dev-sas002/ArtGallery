# All values are optional — the app runs with none of them set.

# Which catalogue adapter to read: "local" (bundled) or "met" (live Met API).
ARTWORK_SOURCE=local

# How long an indexed catalogue is reused before the source is asked again.
CATALOG_CACHE_TTL_MS=600000

# How long a natural-language interpretation is reused.
AI_SEARCH_CACHE_TTL_MS=900000

# Set to enable natural-language search. Leave unset to use the built-in parser.
ANTHROPIC_API_KEY=

# Optional model override.
ANTHROPIC_MODEL=claude-opus-5
