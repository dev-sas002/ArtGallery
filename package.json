{
  "name": "art-gallery",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/build-catalog.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "next": "12.0.10",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "17.0.14",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "eslint": "8.8.0",
    "eslint-config-next": "12.0.10",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.6",
    "typescript": "4.5.5"
  },
  "version": "1.0.0",
  "description": "A small Next.js gallery that browses a public-domain artwork catalogue behind a pluggable source interface.",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
