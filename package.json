{
  "name": "art-gallery",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/build-catalog.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "version": "1.0.0",
  "description": "A small Next.js gallery that browses a public-domain artwork catalogue behind a pluggable source interface.",
  "engines": {
    "node": ">=22"
  }
}
